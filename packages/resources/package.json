{
  "name": "@brambodev/resources",
  "version": "0.5.0",
  "description": "Provider-neutral measurement core for reclaiming agent-created filesystem state: hardlink-aware unique-byte accounting, reclaim classification and collision-safe identity.",
  "keywords": [
    "ai-agent",
    "brambo",
    "resources",
    "worktree",
    "reclamation"
  ],
  "homepage": "https://github.com/SKANL/brambo#readme",
  "bugs": {
    "url": "https://github.com/SKANL/brambo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SKANL/brambo.git",
    "directory": "packages/resources"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "brambo-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "prepack": "pnpm build",
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist"
  ]
}
