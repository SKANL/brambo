{
  "name": "@brambodev/adapter-acp",
  "version": "0.3.2",
  "description": "Protocol-neutral ACP v1 stdio JSON-RPC adapter.",
  "keywords": ["ai-agent", "brambo", "acp", "adapter"],
  "homepage": "https://github.com/SKANL/brambo#readme",
  "bugs": { "url": "https://github.com/SKANL/brambo/issues" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SKANL/brambo.git",
    "directory": "packages/adapter-acp"
  },
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "type": "module",
  "engines": { "node": ">=20" },
  "exports": {
    ".": {
      "brambo-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "prepack": "pnpm build",
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@brambodev/kernel": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": ["dist"]
}
