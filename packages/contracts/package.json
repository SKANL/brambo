{
  "name": "@brambo/contracts",
  "version": "0.1.1",
  "description": "The ports a third party implements to extend brambo, and the published suites that prove an implementation conforms.",
  "keywords": [
    "ai-agent",
    "brambo",
    "contracts",
    "ports",
    "standard-schema",
    "conformance"
  ],
  "homepage": "https://github.com/SKANL/brambo#readme",
  "bugs": {
    "url": "https://github.com/SKANL/brambo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SKANL/brambo.git",
    "directory": "packages/contracts"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "brambo-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./validation": {
      "brambo-source": "./src/validation.ts",
      "types": "./dist/validation.d.ts",
      "default": "./dist/validation.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "prepack": "pnpm build",
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@brambo/kernel": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "^2.9.1"
  },
  "files": [
    "dist",
    "README.md",
    "METHOD-PLUGIN.md"
  ]
}
