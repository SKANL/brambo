{
  "name": "@brambodev/registry",
  "version": "0.1.1",
  "description": "The canonical environment Registry: scoped storage, portable bundles, and ingest from what is already installed.",
  "keywords": [
    "ai-agent",
    "brambo",
    "registry",
    "mcp-server",
    "skills"
  ],
  "homepage": "https://github.com/SKANL/brambo#readme",
  "bugs": {
    "url": "https://github.com/SKANL/brambo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SKANL/brambo.git",
    "directory": "packages/registry"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "brambo-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "prepack": "pnpm build",
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@brambodev/contracts": "workspace:*",
    "@brambodev/kernel": "workspace:*",
    "@brambodev/lock": "workspace:*",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist"
  ]
}
