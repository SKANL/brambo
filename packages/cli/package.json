{
  "name": "@brambodev/cli",
  "version": "0.3.1",
  "description": "The `brambo` command-line surface: argv, JSON output and exit codes, and nothing more.",
  "keywords": [
    "ai-agent",
    "brambo",
    "cli",
    "mcp",
    "skills",
    "developer-tools"
  ],
  "homepage": "https://github.com/SKANL/brambo#readme",
  "bugs": {
    "url": "https://github.com/SKANL/brambo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SKANL/brambo.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "brambo": "./dist/bin/brambo.js"
  },
  "exports": {
    ".": {
      "brambo-source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/*-live.test.ts' --exclude '**/live-*.test.ts' --exclude '**/*.live.test.ts'",
    "lint": "eslint .",
    "prepack": "pnpm build",
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@brambodev/environment": "workspace:*",
    "@brambodev/session": "workspace:*"
  },
  "devDependencies": {
    "@brambodev/contracts": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist"
  ]
}
