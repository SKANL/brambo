{
  "name": "@brambodev/runtime-local",
  "version": "0.5.0",
  "description": "Local isolated execution runtime for brambo orchestration.",
  "keywords": ["brambo", "runtime", "execution"],
  "homepage": "https://github.com/SKANL/brambo#readme",
  "bugs": { "url": "https://github.com/SKANL/brambo/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/SKANL/brambo.git", "directory": "packages/runtime-local" },
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "type": "module",
  "engines": { "node": ">=20" },
  "exports": { ".": { "brambo-source": "./src/index.ts", "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "prepack": "pnpm build",
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json"
  },
  "dependencies": { "@brambodev/contracts": "workspace:*" },
  "devDependencies": { "@types/node": "catalog:", "typescript": "catalog:", "vitest": "catalog:" },
  "files": ["dist", "README.md"]
}
